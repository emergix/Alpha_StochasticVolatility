\\t\\tdouble* Drho7, double* DkappaV7, double * DV7,\n\\t\\tdouble* Drho8, \
double* DkappaV8, double * DV8,\n\\t\\tdouble* Dalpha11, double* Dalpha12, \
double * Dalpha13, double *\\tDalpha14,\n\\t\\tdouble* Dalpha21, double* \
Dalpha22, double * Dalpha23, double *\\tDalpha24,\n\\t\\tdouble* Dalpha31, \
double* Dalpha32, double * Dalpha33, double *\\tDalpha34,\n\\t\\tdouble* \
Dalpha41, double* Dalpha42, double * Dalpha43, double *\\tDalpha44\n\\t\\t)\n\
\\t\\t{\n\\t\\t\\tdouble Objective;\n\\t\\t\\tvector<double> \
ObjectiveVector(30);\n\\t\\t\\tvector<double> ObjectiveDerivative(40);\n\
\\t\\t\\tvector<double> ObjectiveDerivativeVector(1200);\n\n\
\\t\\t\\t\\tif((flag==0)||(flag==2))\n\\t\\t\\t\\t{\n\
\\t\\t\\t\\t\\t(*objective)= \>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
