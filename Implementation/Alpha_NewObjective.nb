 RowBox[{
  RowBox[{"WriteString", "[", 
   RowBox[{
   "str", ",", 
    "\"\<void Alpha_4Assets_NewObjective_WithDerivatives(\n///  flag =0 only \
evaluation, =1, only derivative, =2 , evaluation +derivatives\nint flag,\n/// \
 mode= 0 pure generator spreadoption evaluation, =1, incremental generator + \
BilogToHeston Optimization for the spreadoption evaluation\nint mode,\n\
\\t\\tdouble S1,double  S2,double  S3,double  S4,\n/// PCA decomposition\n\\t\
\\tdouble alpha11, double alpha12, double alpha13, double alpha14,\n\
\\t\\tdouble alpha21, double alpha22, double alpha23, double alpha24,\n\
\\t\\tdouble alpha31, double alpha32, double alpha33, double alpha34,\n\
\\t\\tdouble alpha41, double alpha42, double alpha43, double alpha44,\n/// \
Valeur cible des observables d'underlying\n\\t\\tdouble rhoU1,double \
kappaU1,double VU1,\n\\t\\tdouble rhoU2,double kappaU2,double VU2,\n\
\\t\\tdouble rhoU3,double kappaU3,double VU3,\n\\t\\tdouble rhoU4,double \
kappaU4,double VU4,\n/// Valeur cible des observables de spreadoptions\n\
\\t\\tdouble CovSpread12, double VarSpread12, double V12,\n\\t\\tdouble \
CovSpread13, double VarSpread13, double V13,\n\\t\\tdouble CovSpread14, \
double VarSpread14, double V14,\n\\t\\tdouble CovSpread23, double \
VarSpread23, double V23,\n\\t\\tdouble CovSpread24, double VarSpread24, \
double V24,\n\\t\\tdouble CovSpread34, double VarSpread34, double V34,\n/// \
approximation lineaire de l'optimization Bilog to Heston\n\\t\\tdouble \
V12Ini,double V12DerV1,double V12DerV2,double V12DerV12, double \
CovV12Ini,double CovV12DerV1,double CovV12DerV2,double CovV12DerV12,double \
VarV12Ini,double VarV12DerV1,double VarV12DerV2,double VarV12DerV12,\n\
\\t\\tdouble V13Ini,double V13DerV1,double V13DerV2,double V13DerV12, double \
CovV13Ini,double CovV13DerV1,double CovV13DerV2,double CovV13DerV12,double \
VarV13Ini,double VarV13DerV1,double VarV13DerV2,double VarV13DerV12,\n\
\\t\\tdouble V14Ini,double V14DerV1,double V14DerV2,double V14DerV12, double \
CovV14Ini,double CovV14DerV1,double CovV14DerV2,double CovV14DerV12,double \
VarV14Ini,double VarV14DerV1,double VarV14DerV2,double VarV14DerV12,\n\
\\t\\tdouble V23Ini,double V23DerV1,double V23DerV2,double V23DerV12, double \
