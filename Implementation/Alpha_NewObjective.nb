VarV34Ini,double VarV34DerV1,double VarV34DerV2,double VarV34DerV12,\n/// \
Coefficients de l'optimisation multi objective\n\\t\\tdouble CoeffVU1,\n\
\\t\\tdouble CoeffVU2,\n\\t\\tdouble CoeffVU3,\n\\t\\tdouble CoeffVU4,\n\
\\t\\tdouble CoeffVarVU1,\n\\t\\tdouble CoeffVarVU2,\n\\t\\tdouble \
CoeffVarVU3,\n\\t\\tdouble CoeffVarVU4,\n\\t\\tdouble CoeffCovVU1,\n\
\\t\\tdouble CoeffCovVU2,\n\\t\\tdouble CoeffCovVU3,\n\\t\\tdouble \
CoeffCovVU4,\n\\t\\tdouble CoeffVSpread12,\n\\t\\tdouble CoeffVSpread13,\n\\t\
\\tdouble CoeffVSpread14,\n\\t\\tdouble CoeffVSpread23,\n\\t\\tdouble \
CoeffVSpread24,\n\\t\\tdouble CoeffVSpread34,\n\\t\\tdouble CoeffCovSpread12,\
\n\\t\\tdouble CoeffCovSpread13,\n\\t\\tdouble CoeffCovSpread14,\n\
\\t\\tdouble CoeffCovSpread23,\n\\t\\tdouble CoeffCovSpread24,\n\\t\\tdouble \
CoeffCovSpread34,\n\\t\\tdouble CoeffVarSpread12,\n\\t\\tdouble \
CoeffVarSpread13,\n\\t\\tdouble CoeffVarSpread14,\n\\t\\tdouble \
CoeffVarSpread23,\n\\t\\tdouble CoeffVarSpread24,\n\\t\\tdouble \
CoeffVarSpread34,\n/// valeur initiales des couleur de drivers\n\\t\\tdouble \
rho1, double kappaV1, double V1,\n\\t\\tdouble rho2, double kappaV2, double \
V2,\n\\t\\tdouble rho3, double kappaV3, double V3,\n\\t\\tdouble rho4, double \
kappaV4, double V4,\n\\t\\tdouble rho5, double kappaV5, double V5,\n\
\\t\\tdouble rho6, double kappaV6, double V6,\n\\t\\tdouble rho7, double \
kappaV7, double V7,\n\\t\\tdouble rho8, double kappaV8, double V8,\n/// \
resultats\n\\t\\tdouble* objective,\n\\t\\tdouble* Drho1, double* DkappaV1, \
double * DV1,\n\\t\\tdouble* Drho2, double* DkappaV2, double * DV2,\n\
\\t\\tdouble* Drho3, double* DkappaV3, double * DV3,\n\\t\\tdouble* Drho4, \
double* DkappaV4, double * DV4,\n\\t\\tdouble* Drho5, double* DkappaV5, \
