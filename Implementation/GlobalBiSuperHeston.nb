Cell[BoxData[
 RowBox[{
  RowBox[{"RiccatiSolve", "[", 
   RowBox[{
   "\[Kappa]_", ",", "b_", ",", "c_", ",", "\[Lambda]_", ",", "\[Theta]_", 
    ",", "\[Tau]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Psi]p", ",", "\[Psi]m", ",", "\[Zeta]", ",", "A", ",", "B"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Zeta]", "=", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["b", "2"], "-", 
        RowBox[{
         SuperscriptBox["\[Kappa]", "2"], " ", " ", "c"}]}]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Psi]p", "=", " ", 
      RowBox[{
       RowBox[{"-", "b"}], "+", "\[Zeta]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Psi]m", "=", " ", 
      RowBox[{"b", "+", "\[Zeta]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"B", "=", 
      FractionBox[
       RowBox[{"c", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[Zeta]"}], "  ", "\[Tau]"}]]}], ")"}]}], 
       RowBox[{"\[Psi]m", "+", 
        RowBox[{"\[Psi]p", " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[Zeta]"}], "  ", "\[Tau]"}]]}]}]]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[Theta]", " ", "\[Lambda]", " ", 
         RowBox[{"(", " ", 
          RowBox[{
           RowBox[{"\[Tau]", " ", "\[Psi]p"}], " ", "+", 
           RowBox[{"2", "  ", 
            RowBox[{"Log", "[", 
             FractionBox[
              RowBox[{"\[Psi]m", "+", 
               RowBox[{"\[Psi]p", " ", 
                SuperscriptBox["\[ExponentialE]", 
                 RowBox[{
                  RowBox[{"-", "\[Zeta]"}], " ", "\[Tau]"}]]}]}], 
              RowBox[{"2", " ", "\[Zeta]", "  "}]], "]"}]}]}], ")"}]}], 
        RowBox[{" ", 
         SuperscriptBox["\[Kappa]", "2"]}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"A", ",", "B"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
